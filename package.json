{
  "name": "aporia-design-system",
  "version": "0.2.0",
  "private": true,
  "description": "Canonical Aporia design tokens and the Lacuna Paper/Ink theme family",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:core": "node aporia/build.mjs",
    "build:platforms": "node scripts/build-platforms.mjs",
    "build:gallery": "node scripts/build-gallery.mjs",
    "build": "npm run build:core && npm run build:platforms && npm run build:gallery",
    "test": "node scripts/check.mjs",
    "check:drift": "node scripts/check-drift.mjs",
    "verify": "npm run build && npm test && npm run check:drift",
    "build:site": "node scripts/build-site.mjs",
    "package:skill": "node scripts/package-skill.mjs",
    "test:visual": "node scripts/check-visual.mjs",
    "capture:browser": "npm run build:site && node scripts/check-visual.mjs --capture"
  },
  "devDependencies": {
    "axe-core": "4.14.1",
    "marked": "18.3.0",
    "playwright": "1.65.1"
  }
}
