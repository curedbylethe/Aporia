        "ansi-8":  { "$type": "color", "$value": "{color.ref.ash-readable}" },
        "ansi-9":  { "$type": "color", "$value": "{color.ref.red-pale}" },
        "ansi-10": { "$type": "color", "$value": "{color.ref.sage-paler}" },
        "ansi-11": { "$type": "color", "$value": "{color.ref.ochre-pale}" },
        "ansi-12": { "$type": "color", "$value": "{color.ref.slate-paler}" },
        "ansi-13": { "$type": "color", "$value": "{color.ref.plum-paler}" },
        "ansi-14": { "$type": "color", "$value": "{color.ref.teal-paler}" },
        "ansi-15": { "$type": "color", "$value": "{color.ref.bone}" }
      }
    }
  },

  "font": {
    "display": { "$type": "fontFamily", "$value": ["Russo One", "Arial Black", "system-ui", "sans-serif"] },
    "body":    { "$type": "fontFamily", "$value": ["Golos Text", "Vazirmatn", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Arial", "sans-serif"] },
    "mono":    { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "SF Mono", "Menlo", "monospace"] }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },  "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" }, "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" }, "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" }, "8": { "$type": "dimension", "$value": "64px" },
    "9": { "$type": "dimension", "$value": "96px" }, "10": { "$type": "dimension", "$value": "128px" }
  },
  "radius": {
    "none":  { "$type": "dimension", "$value": "0px", "$description": "Everything" },
    "input": { "$type": "dimension", "$value": "2px", "$description": "Text inputs only" }
  },
  "stroke": {
    "hair":   { "$type": "dimension", "$value": "1px" },
    "strong": { "$type": "dimension", "$value": "2px" },
    "focus":  { "$type": "dimension", "$value": "2px", "$description": "Drawn at 4px offset (web), 2px offset in dense UI" }
  },
  "motion": {
    "fast":       { "$type": "duration", "$value": "90ms",  "$description": "Press" },
    "normal":     { "$type": "duration", "$value": "140ms", "$description": "Rule draw, hover" },
    "deliberate": { "$type": "duration", "$value": "240ms", "$description": "Panel" },
    "ease":       { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  }
}
